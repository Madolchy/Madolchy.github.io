// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator zod {
  provider = "zod-prisma-types"
  output   = "../src/generated/zod"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGO_URL")
}

model User {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  name             String
  email            String        @unique
  role             String?
  passwordHash     String
  isPremium        Boolean       @default(false)
  uuid             String        @unique
  items            DesktopItem[] @relation("UserItems")
  backgroundIconId String?       @unique @db.ObjectId
  backgroundIcon   DesktopItem?  @relation("UserBackground", fields: [backgroundIconId], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model DesktopItem {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  type     String
  name     String
  cell     Int
  /// @zod.custom.use(z.number().int().gte(0).lte(1e+7))
  bytes    Int?
  userId   String
  folderId String?

  user           User          @relation("UserItems", fields: [userId], references: [uuid], onDelete: NoAction, onUpdate: NoAction)
  backgroundUser User?         @relation("UserBackground")
  parent         DesktopItem?  @relation("FolderContents", fields: [folderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children       DesktopItem[] @relation("FolderContents")

  @@unique([userId, folderId, name])
}
